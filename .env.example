# E-Commerce Harness 环境变量
# 复制为 .env 并填入真实 API Key
# 至少配置 OPENAI_API_KEY 即可跑通全流程

# ── OpenAI — vision / text / image ──
OPENAI_API_KEY=sk-...

# ── DeepSeek — text（省钱方案）──
DEEPSEEK_API_KEY=sk-...

# ── Anthropic (Claude) — vision / text（长上下文）──
ANTHROPIC_API_KEY=sk-ant-...

# ── 即梦AI (Seedream 5.0) — image（国内电商首选）──
# 方式1: 火山引擎 AK/SK
VOLCANO_ACCESS_KEY=
VOLCANO_SECRET_KEY=
# 方式2: 即梦AI 平台 Key
SEEDREAM_API_KEY=

# ── 阿里通义千问 (Qwen) — vision / text（国内备选）──
DASHSCOPE_API_KEY=

# ── FLUX.1 — image（写实场景图）──
# 三选一即可
BFL_API_KEY=           # https://api.bfl.ml
FAL_KEY=               # https://fal.ai
REPLICATE_API_KEY=     # https://replicate.com

# ── 应用配置（可选，覆盖 config/default.yaml）──
ECOMM_MOCK_MODE=false
ECOMM_LOG_LEVEL=INFO
ECOMM_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── 运行期目录重定向（可选，第三轮审计 B2-18）──
# ECOMM_DATA_DIR：checkpoint / 审计日志 / Agent 记忆 / workflow.db 的根目录
#   默认 <项目根>/data；容器部署可指向挂载卷
# ECOMM_PROJECT_ROOT：配置文件基准目录（config/**）
#   默认项目根；测试与多实例部署可指向副本/挂载卷
ECOMM_DATA_DIR=
ECOMM_PROJECT_ROOT=

# ── 生成图输出目录（可选；也可在设置页「生成图输出目录」里改）──
# 生成图自动落盘到 {ECOMM_OUTPUT_DIR}/{租户}/{会话ID}/{平台}_{品类}_{序号}.png
# 默认 <项目根>/output（与 deploy/docker-compose.yml 的 harness_output 卷一致）。
# 注意：该变量一旦设置，设置页对应输入框变为只读（改这里后需重启）。
ECOMM_OUTPUT_DIR=

# ── 平台鉴权（可选，不配置则 API 全部开放，仅限开发环境）──
# 配置后所有 REST API 需携带 X-API-Key: <ECOMM_API_KEY>（或 Bearer）访问
# 全局 Key = 管理员身份；管理端点（/api/settings/*、/api/admin/*）仅管理员可用
ECOMM_API_KEY=

# ── 租户独立 API Key（C2 方案①：每租户一把钥匙，可选）──
# 格式: 租户ID:密钥,租户ID:密钥（租户须已在 ECOMM_TENANTS 注册）
# 持租户 Key 的请求身份绑定该租户：X-Tenant-ID 声明被忽略（防伪造），
# 且无权访问管理端点。也可经设置页管理（持久化到 config/tenant_keys.yaml）
ECOMM_TENANT_KEYS=

# ── 租户注册（可选；未配置则只有 default 租户）──
# 格式: 租户ID:套餐,租户ID:套餐（套餐: free/pro/enterprise）
# 例: ECOMM_TENANTS=brand_a:pro,brand_b:free
ECOMM_TENANTS=

# ── 工作流入站 Webhook 鉴权（M4，可选）──
# 配置后 POST /api/webhooks/workflows/{id}/decision 需携带 X-Webhook-Token
# 未配置时该回调端点返回 503（停用）
ECOMM_WEBHOOK_TOKEN=
