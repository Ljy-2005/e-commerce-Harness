# E-Commerce Harness 环境变量
# 复制为 .env 并填入真实 API Key
# 至少配置 OPENAI_API_KEY 即可跑通全流程

# ── OpenAI — vision / text / image ──
OPENAI_API_KEY=sk-...

# ── DeepSeek — text（省钱方案）──
DEEPSEEK_API_KEY=sk-...

# ── Anthropic (Claude) — vision / text（长上下文）──
ANTHROPIC_API_KEY=sk-ant-...

# ── 即梦AI (Seedream 5.0) — image（国内电商首选）──
# 方式1: 火山引擎 AK/SK
VOLCANO_ACCESS_KEY=
VOLCANO_SECRET_KEY=
# 方式2: 即梦AI 平台 Key
SEEDREAM_API_KEY=

# ── 阿里通义千问 (Qwen) — vision / text（国内备选）──
DASHSCOPE_API_KEY=

# ── FLUX.1 — image（写实场景图）──
# 三选一即可
BFL_API_KEY=           # https://api.bfl.ml
FAL_KEY=               # https://fal.ai
REPLICATE_API_KEY=     # https://replicate.com

# ── 应用配置（可选，覆盖 config/default.yaml）──
ECOMM_MOCK_MODE=false
ECOMM_LOG_LEVEL=INFO
ECOMM_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
