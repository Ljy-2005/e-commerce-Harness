{
  "_comment": [
    "敏感内容扫描规则。severity=hard 会阻止提交，severity=warn 只提示。",
    "修改后无需改代码，scripts/check_secrets.py 启动时读取本文件。",
    "本文件自身的路径始终被跳过，避免把规则里的示例密钥当成真实泄漏。"
  ],

  "sensitive_paths": [
    {"glob": ".env",                          "reason": "环境变量文件（含真实密钥）"},
    {"glob": ".env.*",                        "reason": "环境变量文件", "except": [".env.example"]},
    {"glob": "*.pem",                         "reason": "证书/私钥"},
    {"glob": "*.key",                         "reason": "私钥"},
    {"glob": "*.p12",                         "reason": "证书库"},
    {"glob": "*.pfx",                         "reason": "证书库"},
    {"glob": "id_rsa*",                       "reason": "SSH 私钥"},
    {"glob": "id_ed25519*",                   "reason": "SSH 私钥"},
    {"glob": "config/secrets.yaml",           "reason": "本项目真实 API Key 存放处"},
    {"glob": "config/tenant_keys.yaml",       "reason": "多租户 API Key"},
    {"glob": "config/providers.yaml",         "reason": "私有服务商端点"},
    {"glob": "config/custom_providers.yaml",  "reason": "自定义服务商（可能含私有端点）"},
    {"glob": "config/chat.yaml",              "reason": "本地会话策略配置"},
    {"glob": "config/output.yaml",            "reason": "本地输出目录配置"},
    {"glob": "config/pricing.yaml",           "reason": "本地计价配置"},
    {"glob": "config/*.local.yaml",           "reason": "本地覆盖配置"},

    {"glob": "*.docx",    "reason": "Office 文档（简历等个人信息）"},
    {"glob": "*.doc",     "reason": "Office 文档（个人信息）"},
    {"glob": "*.pdf",     "reason": "PDF 文档（简历等个人信息）"},
    {"glob": "*简历*",     "reason": "个人简历"},
    {"glob": "*resume*",  "reason": "个人简历"},
    {"glob": "*证件*",     "reason": "个人证件"},
    {"glob": "*身份证*",    "reason": "身份证件"},
    {"glob": "*预览*",     "reason": "简历/文档预览图"}
  ],

  "content_rules": [
    {"id": "openai-key",     "severity": "hard", "regex": "sk-[A-Za-z0-9]{28,}",
     "desc": "OpenAI 风格密钥（sk- 开头长串）"},
    {"id": "anthropic-key",  "severity": "hard", "regex": "sk-ant-[A-Za-z0-9_\\-]{20,}",
     "desc": "Anthropic 密钥"},
    {"id": "ark-key",        "severity": "hard",
     "regex": "ark-[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}",
     "desc": "火山方舟 API Key"},
    {"id": "aws-akid",       "severity": "hard", "regex": "AKIA[0-9A-Z]{16}",
     "desc": "AWS Access Key ID"},
    {"id": "github-token",   "severity": "hard", "regex": "gh[pousr]_[A-Za-z0-9]{36,}",
     "desc": "GitHub 令牌"},
    {"id": "slack-token",    "severity": "hard", "regex": "xox[baprs]-[A-Za-z0-9\\-]{10,}",
     "desc": "Slack 令牌"},
    {"id": "private-key",    "severity": "hard", "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----",
     "desc": "PEM 私钥块"},
    {"id": "plaintext-password", "severity": "hard",
     "regex": "(?i)(password|passwd|pwd)\\s*[:=]\\s*[\"']?[A-Za-z0-9!@#$%^&*_\\-]{6,}",
     "desc": "配置文件中的明文口令",
     "only_ext": [".yaml", ".yml", ".env", ".ini", ".cfg", ".conf", ".properties", ".toml"]},
    {"id": "jdbc-url-password", "severity": "hard",
     "regex": "(?i)jdbc:[a-z]+://[^\\s\"']*password=[^\\s&\"']+",
     "desc": "JDBC 连接串内嵌口令"},

    {"id": "jwt",            "severity": "warn",
     "regex": "eyJ[A-Za-z0-9_\\-]{12,}\\.[A-Za-z0-9_\\-]{12,}\\.[A-Za-z0-9_\\-]{12,}",
     "desc": "JWT 令牌（可能是测试夹具）"},
    {"id": "high-entropy-hex", "severity": "warn", "regex": "\\b[0-9a-fA-F]{32,}\\b",
     "desc": "长十六进制串（可能是密钥/签名）"},
    {"id": "credential-assignment", "severity": "warn",
     "regex": "(?i)(api_?key|apikey|secret|token|access_?key)\\s*[:=]\\s*[\"'][A-Za-z0-9_\\-/+=]{16,}[\"']",
     "desc": "疑似凭据赋值（引号内长串）"},
    {"id": "cn-mobile",      "severity": "warn", "regex": "(?<![0-9])1[3-9][0-9]{9}(?![0-9])",
     "desc": "中国大陆手机号（个人信息）"}
  ],

  "allowlist": {
    "_comment": [
      "命中的文件路径 glob -> 免检理由。用于压掉测试夹具/文档示例的误报。",
      "整目录免检会漏掉真实泄漏，所以这里只列 '确知含构造数据' 的路径。"
    ],
    "paths": [
      {"glob": ".env.example",                    "reason": "官方占位符模板，值均为 sk-... 形式"},
      {"glob": "frontend/src/chatFormat.test.js", "reason": "TOS 签名脱敏逻辑的构造测试数据"},
      {"glob": "frontend/src/**/*.test.js",       "reason": "前端测试夹具"},
      {"glob": "frontend/src/**/*.test.jsx",      "reason": "前端测试夹具"},
      {"glob": "tests/**",                        "reason": "后端测试夹具（含构造的假密钥）"},
      {"glob": "docs/coverage_baseline.json",     "reason": "覆盖率基线，含文件哈希"},
      {"glob": "package-lock.json",               "reason": "依赖锁文件，含大量 integrity 哈希"},
      {"glob": "frontend/package-lock.json",      "reason": "依赖锁文件，含大量 integrity 哈希"}
    ]
  },

  "scan": {
    "skip_ext": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".ico", ".svg", ".woff", ".woff2",
                 ".ttf", ".eot", ".mp4", ".mp3", ".zip", ".gz", ".7z", ".rar", ".exe", ".dll",
                 ".so", ".dylib", ".pyc", ".class", ".jar", ".db", ".sqlite", ".bin"],
    "skip_paths": ["frontend/dist/**", "node_modules/**", "data/**", "output/**",
                   "__pycache__/**", ".pytest_cache/**", "target/**"],
    "max_file_bytes": 1048576,
    "inline_allow": "# secret-scan: allow"
  }
}
